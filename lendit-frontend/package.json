{
  "name": "lendit-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "typecheck": "vue-tsc --build"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@ender_romantice/vue-grab": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.12",
    "vue-tsc": "^3.3.11"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "trailingComma": "all",
    "arrowParens": "always",
    "vueIndentScriptAndStyle": false,
    "htmlWhitespaceSensitivity": "css"
  }
}
